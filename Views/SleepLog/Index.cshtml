@model List<SleepTracker.Models.SleepAndHabitLog>

<h1>Sleep Tracker</h1>

<a asp-action="Create">Add Sleep and Habit Log</a>

<br />
<br />

@if (Model.Count == 0)
{
    <p>No records have been added yet.</p>
}
else
{
    @foreach (var record in Model)
    {
        <h2>Sleep Information</h2>

        <p>Bedtime: @record.Bedtime</p>
        <p>Wake Time: @record.Waketime</p>
        <p>Hours Slept: @record.HoursSlept</p>
        <p>Sleep Quality: @record.SleepQuality / 10</p>

        <h2>Habit Information</h2>

        <p>Last Caffeine: @record.LastCaffeine</p>
        <p>Last Ate: @record.LastAte</p>
        <p>Last Exercised: @record.LastExercised</p>
        <p>Wake Up Time: @record.WakeUpTime</p>
        <p>Medication Time: @record.MedicationTime</p>

        <hr />
    }
}